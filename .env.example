# Copy to .env for local runs, or set these in your hosting dashboard.

# Postgres connection string (Neon, Supabase, Render…). Without it a local dev database is used.
DATABASE_URL=

# Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=
# Model for replies (default claude-opus-5-5). Change only if you decide to.
# REZA_MODEL=claude-opus-5-5
# REZA_EFFORT=low

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Public address of the server, e.g. https://reza.onrender.com (needed for the Telegram webhook)
PUBLIC_URL=

# Instagram Direct (Meta app → Instagram → API setup with Instagram login)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# any string you invent; type the same one into the webhook settings in Meta
INSTAGRAM_VERIFY_TOKEN=

# Long random strings
SESSION_SECRET=
CRON_SECRET=

# Shown on /privacy, /terms and /data-deletion (support address and operator name)
CONTACT_EMAIL=
LEGAL_NAME=
