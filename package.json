{
  "name": "reza",
  "version": "0.1.0",
  "private": true,
  "description": "Reza — AI receptionist for small businesses and a client catalogue",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build-spa.mjs",
